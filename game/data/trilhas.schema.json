{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trilhas de traço",
  "description": "Cada número, sinal ou letra tem um ou mais traços, na ordem de escrita. Um traço é uma sequência de pontos [x, y] entre 0 e 1 dentro do quadrado do glifo (x para a direita, y para baixo); o primeiro ponto é o início numerado.",
  "type": "object",
  "required": ["version", "glyphs"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["glyph", "strokes"],
        "additionalProperties": false,
        "properties": {
          "glyph": { "type": "string", "minLength": 1, "maxLength": 1 },
          "strokes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
