{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquipelago-do-ceu/schemas/mission.schema.json",
  "title": "Missão",
  "description": "Conteúdo de um Desafio. O JSON só escolhe uma Mecânica que já existe no jogo e passa parâmetros; nunca carrega código.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "discipline", "concept", "bncc", "year", "difficulty", "mechanic", "params", "prompt", "hints", "explanation", "accessibility", "review"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "discipline": { "enum": ["matematica", "portugues"] },
    "concept": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "bncc": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^EF0[1-3](MA|LP)[0-9]{2}$" }
    },
    "year": { "type": "integer", "minimum": 1, "maximum": 3 },
    "stretch": { "type": "boolean" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "mechanic": { "enum": ["compor_numero", "comparar_quantidades", "completar_sequencia", "formar_palavras", "escrever_palavra", "ordenar_frases", "completar_frase", "pagar_troco"] },
    "params": { "type": "object" },
    "prompt": { "type": "string", "minLength": 1 },
    "hints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "explanation": { "type": "string", "minLength": 1 },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timerAllowed"],
      "properties": { "timerAllowed": { "type": "boolean" } }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "by": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mechanic": { "const": "compor_numero" } }, "required": ["mechanic"] },
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "required": ["target", "pieces", "maxPieces"],
            "properties": {
              "target": { "type": "integer", "minimum": 1 },
              "pieces": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 1 } },
              "maxPieces": { "type": "integer", "minimum": 2 },
              "question": { "type": "string", "pattern": "^[0-9]+( [+-] [0-9]+)+$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mechanic": { "const": "formar_palavras" } }, "required": ["mechanic"] },
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "required": ["syllables", "pool", "distractors", "image"],
            "properties": {
              "syllables": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-zà-ú]+$" } },
              "pool": { "type": "array", "items": { "type": "string", "pattern": "^[a-zà-ú]+$" } },
              "distractors": { "type": "integer", "minimum": 0 },
              "image": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mechanic": { "const": "escrever_palavra" } }, "required": ["mechanic"] },
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "required": ["word", "image"],
            "properties": {
              "word": { "type": "string", "pattern": "^[a-zà-ú]+$" },
              "image": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "distractors": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mechanic": { "const": "ordenar_frases" } }, "required": ["mechanic"] },
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "required": ["words", "pool", "distractors", "image"],
            "properties": {
              "words": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^[A-Za-zÀ-ú]+[.!?]?$" } },
              "pool": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-zÀ-ú]+[.!?]?$" } },
              "distractors": { "type": "integer", "minimum": 0 },
              "image": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mechanic": { "const": "pagar_troco" } }, "required": ["mechanic"] },
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "required": ["task", "price"],
            "properties": {
              "task": { "enum": ["pagar", "troco"] },
              "price": { "type": "integer", "minimum": 5, "maximum": 200000 },
              "given": { "type": "integer", "minimum": 10, "maximum": 200000 },
              "pieces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 5 } }
            }
          }
        },
        "if": { "properties": { "params": { "properties": { "task": { "const": "troco" } }, "required": ["task"] } }, "required": ["params"] },
        "then": { "properties": { "params": { "required": ["given"] } } }
      }
    },
    {
      "if": { "properties": { "mechanic": { "const": "completar_frase" } }, "required": ["mechanic"] },
      "then": {
        "properties": {
          "params": {
            "additionalProperties": false,
            "required": ["before", "after", "answer", "options", "image"],
            "properties": {
              "before": { "type": "string" },
              "after": { "type": "string" },
              "answer": { "type": "string", "minLength": 1 },
              "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
              "image": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
            }
          }
        }
      }
    }
  ]
}
